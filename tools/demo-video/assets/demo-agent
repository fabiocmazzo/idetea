#!/usr/bin/env python3
"""Stand-in for a coding agent CLI in the demo videos.

It only prints what it receives. It never calls a model, the network or any
other program. The demo's user config lists it under [agents.launchers].
"""
import select
import sys

DIM, CYAN, GREEN, RESET = "\033[2m", "\033[36m", "\033[32m", "\033[0m"
print(f"{CYAN}demo-agent{RESET} {DIM}· a stand-in for a coding agent (local script, calls nothing){RESET}")


def prompt():
    sys.stdout.write(f"{GREEN}› {RESET}")
    sys.stdout.flush()


prompt()
lines = []
while True:
    ready, _, _ = select.select([sys.stdin], [], [], 0.4)
    if ready:
        line = sys.stdin.readline()
        if not line:
            break
        lines.append(line.rstrip("\n"))
        continue
    if lines:
        first = next((l for l in lines if l.strip()), "")
        print(f"{DIM}(demo-agent got {len(lines)} lines, starting with {first.strip()}){RESET}")
        lines = []
        prompt()
