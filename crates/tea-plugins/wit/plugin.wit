/// API de plugins da IDE TEA. Protótipo: a versão 0.x pode mudar sem aviso (ver docs/rfc/0002-plugins-wasm.md).
///
/// Um plugin é um componente WASM (`cargo build --target wasm32-wasip2`). Ele vê a pasta do projeto pelo WASI
/// (como `/project`) e conversa com a IDE só por este arquivo: a IDE chama as funções exportadas; o plugin pede
/// coisas importando `host`. Os pedidos são aplicados quando a função exportada termina.
package idetea:plugin@0.1.0;

interface host {
    /// Mensagem curta na barra de avisos.
    notify: func(text: string);
    /// Registra um comando na paleta. O id tem que começar com `<id do plugin>.`.
    register-command: func(id: string, title: string);
    /// Abre um arquivo do projeto (caminho relativo à raiz) na linha e coluna (começando em 1; 0 = início).
    open-file: func(path: string, line: u32, column: u32);
    /// Troca o conteúdo do painel do plugin: um documento `idetea-ui` v1 em JSON (docs/interfaces/formato.md).
    set-panel: func(document: string);
    /// Mostra o painel do plugin.
    show-panel: func();
    /// Linha no log da IDE (stderr com `IDETEA_PLUGIN_LOG=1`).
    log: func(text: string);
}

interface types {
    /// Um botão do painel foi clicado.
    record ui-action {
        /// `action.name` do botão.
        name: string,
        /// `id` do botão.
        source: string,
        /// Objeto JSON: caminho → valor, para os caminhos do `action.context`.
        values: string,
    }

    variant event {
        /// Um arquivo do projeto foi salvo (caminho relativo à raiz).
        file-saved(string),
        /// O arquivo ativo mudou (caminho relativo à raiz; `none` sem arquivo).
        active-file(option<string>),
    }
}

world plugin {
    use types.{ui-action, event};
    import host;

    /// Chamada uma vez, ao carregar. Erro: o plugin fica desligado e a mensagem aparece para o usuário.
    export activate: func() -> result<_, string>;
    /// Um comando registrado pelo plugin foi escolhido.
    export on-command: func(id: string);
    /// Algo aconteceu na IDE.
    export on-event: func(event: event);
    /// Um botão do painel do plugin foi clicado.
    export on-action: func(action: ui-action);
}
