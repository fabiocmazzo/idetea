%YAML 1.2
---
# MoonBit literate files (`.mbt.md`): Markdown whose ```mbt / ```moonbit blocks are MoonBit.
# Written for IDE TEA (Apache-2.0). A small Markdown on purpose: the editor's own Markdown grammar lives in another
# syntax set, which this one cannot embed. The MoonBit code uses `moonbit.sublime-syntax` from the same pack.
name: MoonBit Markdown
file_extensions:
  - mbt.md
scope: text.html.markdown.moonbit

contexts:
  main:
    - match: '^(\s*)(```+|~~~+)\s*((?:mbt|moonbit)\b[^\n]*)$'
      captures:
        2: punctuation.definition.raw.code-fence.begin.markdown
        3: constant.other.language-name.markdown
      embed: scope:source.moonbit
      embed_scope: markup.raw.code-fence.moonbit.markdown-gfm source.moonbit
      escape: '^\1\2\s*$'
      escape_captures:
        0: punctuation.definition.raw.code-fence.end.markdown
    - match: '^(\s*)(```+|~~~+)([^\n]*)$'
      captures:
        2: punctuation.definition.raw.code-fence.begin.markdown
        3: constant.other.language-name.markdown
      push: other-fence
    - match: '^(#{1,6})\s+(.*?)\s*#*\s*$'
      scope: markup.heading.markdown
      captures:
        1: punctuation.definition.heading.begin.markdown
        2: entity.name.section.markdown
    - match: '^\s*(>)'
      captures:
        1: punctuation.definition.blockquote.markdown
    - match: '^\s*([*+-]|\d+[.)])\s'
      captures:
        1: punctuation.definition.list_item.markdown
    - match: '^\s*([-*_])(\s*\1){2,}\s*$'
      scope: meta.separator.markdown
    - include: inline

  other-fence:
    - meta_scope: markup.raw.code-fence.markdown-gfm
    - match: '^\s*(```+|~~~+)\s*$'
      scope: punctuation.definition.raw.code-fence.end.markdown
      pop: true

  inline:
    - match: '(`+)[^`\n]+?\1'
      scope: markup.raw.inline.markdown
    - match: '(\*\*|__)(?=\S)(.+?)(?<=\S)\1'
      scope: markup.bold.markdown
    - match: '(\*|_)(?=\S)(.+?)(?<=\S)\1'
      scope: markup.italic.markdown
    - match: '(!?\[)([^\]\n]*)(\])(\()([^)\s\n]*)(\))'
      captures:
        1: punctuation.definition.link.begin.markdown
        2: string.other.link.title.markdown
        3: punctuation.definition.link.end.markdown
        5: markup.underline.link.markdown
    - match: '<!--'
      push:
        - meta_scope: comment.block.html
        - match: '-->'
          pop: true
