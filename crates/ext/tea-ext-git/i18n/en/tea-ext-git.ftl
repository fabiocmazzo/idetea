## Git
cmd-git-focus = Git: show changes
cmd-git-refresh = Git: refresh
cmd-git-stage-all = Git: stage all
cmd-git-unstage-all = Git: unstage all
cmd-git-commit = Git: commit (focuses the message)
cmd-git-pull = Git: pull (download and merge)
cmd-git-push = Git: push (send commits)
cmd-git-fetch = Git: fetch (check the remote for news)
git-panel = Git
cancel = Cancel
copied = Copied: { $text }
git-notice = Git: { $message }
git-wait = Git: please wait, still { $running }
git-fetching = Fetching…
git-pulling = Pulling…
git-pushing = Pushing…
git-publishing = Publishing…
git-no-repo-notice = Git: this folder is not in a repository
git-no-repo = This folder is not in a git repository.
git-need-message = Git: write the commit message
git-nothing-staged = Git: nothing staged (use + to add)
git-detached-pull = Git: detached HEAD: check out a branch to pull
git-detached-push = Git: detached HEAD: check out a branch to push
git-no-upstream = Git: this branch tracks no remote (push to publish it)
git-no-remote = Git: the repository has no remote (git remote add origin <url>)
git-discarded = changes discarded in { $path }
git-discard-untracked = The file is new (untracked) and goes to the trash.
git-discard-tracked = Unstaged changes will be lost; the file goes back to what is staged/in the last commit.
git-discard-title = Discard changes in "{ $path }"?
git-discard = Discard
git-publish-title = Publish the branch "{ $branch }"?
git-publish-detail = It does not exist on { $remote } yet. The push creates the branch there and starts tracking it (git push -u { $remote } { $branch }).
git-publish = Publish
git-fetch-tip = Fetch: check the remote for news
git-pull-tip = Pull: download and merge{ $count }
git-push-tip = Push: send commits{ $count }
git-refresh = Refresh
git-commit-placeholder = Commit message (Enter)
git-staged = Staged
git-changes = Changes
git-unstage-all = Unstage all
git-stage-all = Stage all
git-unstage = Unstage
git-stage = Stage
git-nothing-to-commit = Nothing to commit.
git-open-file = Open file
git-view-diff = View diff
git-discard-menu = Discard changes…
git-copy-path = Copy path
git-copy-relative = Copy relative path
git-select-file = Select a file to see its diff.
git-diff-truncated = … diff cut at { $count } lines
git-no-diff = No differences (binary file or permissions only).
git-run-error = could not run git: { $error }
git-unknown-error = unknown error
git-trash-error = could not move to the trash: { $error }
git-timeout = timed out ({ $seconds } s) talking to the remote
git-explain-rejected = the remote has commits you don't have: pull first
git-explain-diverged = the local and remote branches diverged: set pull.rebase (or resolve it in the terminal)
git-explain-conflict = pull with conflicts: resolve the marked files and commit
git-explain-overwritten = local changes would be overwritten: commit or discard them before pulling
git-explain-auth = authentication failed: set up a credential helper (e.g. gh auth setup-git)
git-explain-ssh = ssh refused the connection: load the key into the agent (ssh-add) or confirm the server in the terminal
git-explain-network = could not reach the remote (network or address)
git-fetch-done = fetch done
git-up-to-date = already up to date
git-pull-done = pull done
git-published = branch { $branch } published on { $remote }
git-nothing-to-push = nothing to push
git-push-done = push done
