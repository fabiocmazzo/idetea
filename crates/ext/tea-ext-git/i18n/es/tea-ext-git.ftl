## Git
cmd-git-focus = Git: mostrar cambios
cmd-git-refresh = Git: actualizar
cmd-git-stage-all = Git: agregar todo al stage
cmd-git-unstage-all = Git: quitar todo del stage
cmd-git-commit = Git: commit (enfoca el mensaje)
cmd-git-pull = Git: pull (descargar y combinar)
cmd-git-push = Git: push (enviar commits)
cmd-git-fetch = Git: fetch (ver si el remoto tiene novedades)
git-panel = Git
cancel = Cancelar
copied = Copiado: { $text }
git-notice = Git: { $message }
git-wait = Git: espere, todavía { $running }
git-fetching = Buscando…
git-pulling = Descargando…
git-pushing = Enviando…
git-publishing = Publicando…
git-no-repo-notice = Git: esta carpeta no está en un repositorio
git-no-repo = Esta carpeta no está en un repositorio git.
git-need-message = Git: escriba el mensaje del commit
git-nothing-staged = Git: nada en el stage (use + para agregar)
git-detached-pull = Git: HEAD suelto (detached): haga checkout de una rama para el pull
git-detached-push = Git: HEAD suelto (detached): haga checkout de una rama para el push
git-no-upstream = Git: esta rama no sigue ninguna remota (haga push para publicarla)
git-no-remote = Git: el repositorio no tiene remoto (git remote add origin <url>)
git-discarded = cambios descartados en { $path }
git-discard-untracked = El archivo es nuevo (sin seguimiento) y va a la papelera.
git-discard-tracked = Los cambios fuera del stage se perderán; el archivo vuelve a lo que está en el stage/último commit.
git-discard-title = ¿Descartar los cambios en "{ $path }"?
git-discard = Descartar
git-publish-title = ¿Publicar la rama "{ $branch }"?
git-publish-detail = Todavía no existe en { $remote }. El push crea la rama allí y empieza a seguirla (git push -u { $remote } { $branch }).
git-publish = Publicar
git-fetch-tip = Fetch: ver si el remoto tiene novedades
git-pull-tip = Pull: descargar y combinar{ $count }
git-push-tip = Push: enviar commits{ $count }
git-refresh = Actualizar
git-commit-placeholder = Mensaje del commit (Enter)
git-staged = En el stage
git-changes = Cambios
git-unstage-all = Quitar todo del stage
git-stage-all = Agregar todo al stage
git-unstage = Quitar del stage
git-stage = Agregar al stage
git-nothing-to-commit = Nada que commitear.
git-open-file = Abrir archivo
git-view-diff = Ver diff
git-discard-menu = Descartar cambios…
git-copy-path = Copiar ruta
git-copy-relative = Copiar ruta relativa
git-select-file = Seleccione un archivo para ver su diff.
git-diff-truncated = … diff cortado en { $count } líneas
git-no-diff = Sin diferencias (archivo binario o solo permisos).
git-run-error = no se pudo ejecutar git: { $error }
git-unknown-error = error desconocido
git-trash-error = no se pudo mover a la papelera: { $error }
git-timeout = tiempo agotado ({ $seconds } s) hablando con el remoto
git-explain-rejected = el remoto tiene commits que usted no tiene: haga pull antes
git-explain-diverged = la rama local y la remota divergieron: configure pull.rebase (o resuélvalo en la terminal)
git-explain-conflict = pull con conflictos: resuelva los archivos marcados y haga commit
git-explain-overwritten = los cambios locales se sobrescribirían: haga commit o descártelos antes del pull
git-explain-auth = falló la autenticación: configure un credential helper (ej.: gh auth setup-git)
git-explain-ssh = ssh rechazó la conexión: cargue la clave en el agente (ssh-add) o confirme el servidor en la terminal
git-explain-network = no se pudo comunicar con el remoto (red o dirección)
git-fetch-done = fetch hecho
git-up-to-date = ya estaba actualizado
git-pull-done = pull hecho
git-published = rama { $branch } publicada en { $remote }
git-nothing-to-push = nada que enviar
git-push-done = push hecho
