## Git
cmd-git-focus = Git: mostrar mudanças
cmd-git-refresh = Git: atualizar
cmd-git-stage-all = Git: adicionar tudo ao stage
cmd-git-unstage-all = Git: tirar tudo do stage
cmd-git-commit = Git: commit (foca a mensagem)
cmd-git-pull = Git: pull (baixar e juntar)
cmd-git-push = Git: push (enviar commits)
cmd-git-fetch = Git: fetch (ver se o remoto tem novidades)
git-panel = Git
cancel = Cancelar
copied = Copiado: { $text }
git-notice = Git: { $message }
git-wait = Git: aguarde, ainda { $running }
git-fetching = Buscando…
git-pulling = Baixando…
git-pushing = Enviando…
git-publishing = Publicando…
git-no-repo-notice = Git: esta pasta não está num repositório
git-no-repo = Esta pasta não está num repositório git.
git-need-message = Git: escreva a mensagem do commit
git-nothing-staged = Git: nada no stage (use + para adicionar)
git-detached-pull = Git: HEAD solto (detached): faça checkout de uma branch para o pull
git-detached-push = Git: HEAD solto (detached): faça checkout de uma branch para o push
git-no-upstream = Git: esta branch não acompanha nenhuma remota (faça push para publicar)
git-no-remote = Git: o repositório não tem remoto (git remote add origin <url>)
git-discarded = alterações descartadas em { $path }
git-discard-untracked = O arquivo é novo (não rastreado) e vai para a lixeira.
git-discard-tracked = As mudanças fora do stage serão perdidas; o arquivo volta ao que está no stage/último commit.
git-discard-title = Descartar alterações em "{ $path }"?
git-discard = Descartar
git-publish-title = Publicar a branch "{ $branch }"?
git-publish-detail = Ela ainda não existe em { $remote }. O push cria a branch lá e passa a acompanhá-la (git push -u { $remote } { $branch }).
git-publish = Publicar
git-fetch-tip = Fetch: ver se o remoto tem novidades
git-pull-tip = Pull: baixar e juntar{ $count }
git-push-tip = Push: enviar commits{ $count }
git-refresh = Atualizar
git-commit-placeholder = Mensagem do commit (Enter)
git-staged = No stage
git-changes = Mudanças
git-unstage-all = Tirar tudo do stage
git-stage-all = Adicionar tudo ao stage
git-unstage = Tirar do stage
git-stage = Adicionar ao stage
git-nothing-to-commit = Nada para commitar.
git-open-file = Abrir arquivo
git-view-diff = Ver diff
git-discard-menu = Descartar alterações…
git-copy-path = Copiar caminho
git-copy-relative = Copiar caminho relativo
git-select-file = Selecione um arquivo para ver o diff.
git-diff-truncated = … diff cortado em { $count } linhas
git-no-diff = Sem diferenças (arquivo binário ou só permissão).
git-run-error = não foi possível rodar git: { $error }
git-unknown-error = erro desconhecido
git-trash-error = não foi possível mover para a lixeira: { $error }
git-timeout = tempo esgotado ({ $seconds } s) falando com o remoto
git-explain-rejected = o remoto tem commits que você não tem: faça pull antes
git-explain-diverged = a branch local e a remota divergiram: configure pull.rebase (ou resolva no terminal)
git-explain-conflict = pull com conflitos: resolva os arquivos marcados e faça commit
git-explain-overwritten = alterações locais seriam sobrescritas: faça commit ou descarte antes do pull
git-explain-auth = falha de autenticação: configure um credential helper (ex.: gh auth setup-git)
git-explain-ssh = o ssh recusou a conexão: carregue a chave no agente (ssh-add) ou confirme o servidor no terminal
git-explain-network = não foi possível falar com o remoto (rede ou endereço)
git-fetch-done = fetch feito
git-up-to-date = já estava atualizado
git-pull-done = pull feito
git-published = branch { $branch } publicada em { $remote }
git-nothing-to-push = nada para enviar
git-push-done = push feito
