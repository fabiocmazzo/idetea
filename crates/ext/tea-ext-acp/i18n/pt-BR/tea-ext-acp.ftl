acp-panel = Sessão do agente
cmd-acp-focus = Agente (ACP): mostrar a sessão
cmd-acp-opencode = Agente (ACP): OpenCode
cmd-acp-claude = Agente (ACP): Claude Code
cmd-acp-cancel = Agente (ACP): cancelar o turno
acp-empty = Nenhuma sessão ACP. O agente continua no processo dele. A IDE mostra o texto e pergunta antes de cada ação.
acp-opencode = OpenCode
acp-claude = Claude Code
acp-prompt = Mensagem para o agente
acp-send = Enviar
acp-cancel = Cancelar o turno
acp-permission-title = O agente pede permissão
acp-permission-note = Fechar ou cancelar este diálogo não permite a ação. Nada roda sem um clique explícito.
acp-you = Você
acp-thought = pensamento
acp-turn = Turno encerrado ({ $stop }).
acp-closed = A sessão terminou.
acp-failed = A sessão falhou: { $error }
acp-ready = Sessão { $id } pronta. Nada roda sem a sua permissão.
acp-missing-opencode = O OpenCode não está no PATH. Instale o binário opencode e tente de novo. A sessão não foi iniciada.
acp-missing-claude-absent = O adaptador claude-agent-acp não está no PATH e não há Node.js. Instale o Node.js 22 ou mais novo e npm install -g @agentclientprotocol/claude-agent-acp@0.109.0, ou aponte [agents] claude_acp no config do usuário para o binário de uma release. A sessão não foi iniciada.
acp-missing-claude-old = O Node.js é { $version }. O adaptador precisa do Node.js 22 ou mais novo, ou de um binário em [agents] claude_acp. A sessão não foi iniciada.
acp-missing-claude-node = O Node.js é { $version }, mas claude-agent-acp não está no PATH. Instale npm install -g @agentclientprotocol/claude-agent-acp@0.109.0, ou aponte [agents] claude_acp para o arquivo de uma release. A sessão não foi iniciada.
acp-missing-claude-unread = Não deu para ler a versão do Node.js ({ $output }). O adaptador claude-agent-acp não está no PATH. A sessão não foi iniciada.
acp-auth = O Claude Code não está autenticado. Entre com claude (assinatura ou Console) ou defina ANTHROPIC_API_KEY e tente de novo. A sessão não ficou esperando. { $message }
acp-login = Entrar: { $name }
acp-login-task = Login: { $name }
acp-login-done = Login encerrado (código { $code }). Enter fecha a aba.
acp-status-pending = esperando
acp-status-in-progress = em andamento
acp-status-completed = concluída
acp-status-failed = falhou
acp-status-update = atualizada
acp-stop-end = fim do turno
acp-stop-cancelled = cancelado
acp-stop-refusal = recusado
acp-stop-error = erro
