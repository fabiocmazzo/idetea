    },
    {
      "id": "nota",
      "component": "input",
      "label": "Observação",
      "placeholder": "opcional",
      "value": "/nota"
    },
    {
      "id": "aplicar",
      "component": "button",
      "label": "Aplicar",
      "action": {
        "name": "aplicar",
        "context": [
          "/ambiente",
          "/backup",
          "/nota"
        ]
      }
    },
    {
      "id": "cancelar",
      "component": "button",
      "label": "Cancelar",
