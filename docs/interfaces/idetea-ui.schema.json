{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fabiocmazzo/idetea/docs/interfaces/idetea-ui.schema.json",
  "title": "idetea-ui v1",
  "description": "Interface declarativa que um agente escreve em .idetea/ui/<nome>.json. Ver docs/interfaces/formato.md.",
  "type": "object",
  "required": ["format", "version", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "idetea-ui" },
    "version": { "const": 1 },
    "surface": { "$ref": "#/$defs/name" },
    "revision": { "type": "integer", "minimum": 0 },
    "title": { "type": "string", "maxLength": 16384 },
    "source": { "type": "string", "maxLength": 16384 },
    "data": { "type": "object" },
    "submit": { "enum": ["once", "many"] },
    "components": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/component" } }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "text": { "type": "string", "maxLength": 16384 },
    "pointer": { "type": "string", "pattern": "^/", "minLength": 2, "maxLength": 256 },
    "binding": {
      "oneOf": [
        { "$ref": "#/$defs/pointer" },
        { "type": "object", "required": ["path"], "properties": { "path": { "$ref": "#/$defs/pointer" } }, "additionalProperties": false }
      ]
    },
    "component": {
      "type": "object",
      "required": ["id", "component"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "component": { "type": "string" } },
      "allOf": [
        {
          "if": { "properties": { "component": { "const": "text" } } },
          "then": {
            "required": ["text"],
            "properties": { "text": { "$ref": "#/$defs/text" }, "style": { "enum": ["normal", "muted", "warning", "error"] } }
          }
        },
        {
          "if": { "properties": { "component": { "const": "button" } } },
          "then": {
            "required": ["label", "action"],
            "properties": {
              "label": { "$ref": "#/$defs/text" },
              "style": { "enum": ["primary", "secondary", "danger"] },
              "action": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "$ref": "#/$defs/text" },
                  "context": { "type": "array", "items": { "$ref": "#/$defs/pointer" } }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": { "properties": { "component": { "const": "checkbox" } } },
          "then": {
            "required": ["label", "value"],
            "properties": { "label": { "$ref": "#/$defs/text" }, "value": { "$ref": "#/$defs/binding" } }
          }
        },
        {
          "if": { "properties": { "component": { "const": "select" } } },
          "then": {
            "required": ["options", "value"],
            "properties": {
              "label": { "$ref": "#/$defs/text" },
              "value": { "$ref": "#/$defs/binding" },
              "options": {
                "type": "array",
                "maxItems": 500,
                "items": {
                  "oneOf": [
                    { "$ref": "#/$defs/text" },
                    {
                      "type": "object",
                      "required": ["value"],
                      "properties": { "value": { "$ref": "#/$defs/text" }, "label": { "$ref": "#/$defs/text" } },
                      "additionalProperties": false
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "component": { "const": "file" } } },
          "then": {
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 16384, "not": { "pattern": "(^[/\\\\])|(^.:)|(^|[/\\\\])\\.\\.([/\\\\]|$)" } },
              "line": { "type": "integer", "minimum": 0 },
              "column": { "type": "integer", "minimum": 0 },
              "label": { "$ref": "#/$defs/text" },
              "open": { "type": "boolean" }
            }
          }
        },
        {
          "if": { "properties": { "component": { "const": "input" } } },
          "then": {
            "required": ["value"],
            "properties": {
              "label": { "$ref": "#/$defs/text" },
              "placeholder": { "$ref": "#/$defs/text" },
              "value": { "$ref": "#/$defs/binding" }
            }
          }
        }
      ]
    }
  }
}
